# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL with the pgvector extension available on the server.
DATABASE_URL=postgresql://privateai:CHANGE_ME@localhost:5432/privateai
TEST_DATABASE_URL=postgresql://privateai:CHANGE_ME@localhost:5432/private_ai_test

# Answer generation (vLLM OpenAI-compatible API).
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local
VLLM_MODEL=Qwen/Qwen3-4B

# Dense embeddings for RAG (loaded in-process by default).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# API authentication: JSON map of sha256(api_key) -> principal metadata.
# Generate a digest with:  printf '%s' 'your-key' | sha256sum
# Example shape (replace digests and namespaces):
# PRIVATE_AI_API_KEYS_JSON={"<sha256>":{"principal_id":"lab","allowed_namespaces":["ai-ops-demo"]}}
# 
PRIVATE_AI_API_KEYS_JSON='[
  {
    "principal_id": "beta-user-1",
    "key_sha256": "",
    "allowed_namespaces": ["ai-ops-demo"]
  }
]'

# Optional: speech extras (uv sync --group speech) and session cookie hardening.
# PRIVATE_AI_SESSION_TTL_SECONDS=28800
# PRIVATE_AI_SESSION_IDLE_SECONDS=1800
# PRIVATE_AI_COOKIE_SECURE=1
# PRIVATE_AI_HYPOTHESES=1
